# Copy this file to .env and fill in your values.
# If GROQ_API_KEY is left empty, the system runs in MOCK LLM mode
# (rule-based fallback) so you can test the full pipeline with zero setup.

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Confidence below this -> escalate to LLM (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.45

# Cost assumptions (USD per 1000 events) - purely for the dashboard metric
COST_PER_1000_CLASSICAL=0.02
COST_PER_1000_LLM=2.50
